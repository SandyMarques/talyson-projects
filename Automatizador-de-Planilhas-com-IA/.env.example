# Chave de API da DeepSeek (Obtenha em: https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
# Endpoint padrão da API DeepSeek (ou endpoint customizado como Ollama / OpenRouter)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modelo padrão (deepseek-chat ou deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat
