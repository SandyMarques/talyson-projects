# =============================================================================
# Provedor Principal de LLM (deepseek ou openai)
# =============================================================================
LLM_PROVIDER=deepseek

# Configurações do DeepSeek
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Provedor de Embeddings ('huggingface' local/gratuito ou 'openai')
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Configurações da OpenAI (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# SEGURANÇA — leia antes de expor o serviço
# =============================================================================
# Chave exigida no header `X-API-Key` de todas as rotas de dados (upload, listagem,
# exclusão e /chat). Gere uma aleatória, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Mantenha `true`. Com `false` a API fica SEM autenticação (apenas para uso local).
REQUIRE_API_KEY=true

# Origens permitidas por CORS. NUNCA use "*" em ambiente publicado.
# Aceita JSON ou lista separada por vírgulas.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Expõe /docs, /redoc e /openapi.json. Deixe `false` fora de desenvolvimento.
EXPOSE_DOCS=false

# =============================================================================
# Limites de recurso
# =============================================================================
# Tamanho máximo de upload, em bytes (padrão 25 MB).
MAX_UPLOAD_BYTES=26214400
# Teto de caracteres do contexto montado a partir dos documentos.
MAX_CONTEXT_CHARS=12000
# Tempo máximo de espera do provedor de LLM, em segundos.
LLM_TIMEOUT_SECONDS=60
# Teto de tokens da resposta gerada.
LLM_MAX_TOKENS=1500

# =============================================================================
# ChromaDB e RAG
# =============================================================================
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=rag_documents

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4
# Distância máxima aceita na recuperação (L2 ao quadrado; menor = mais parecido).
# Trechos acima disso são descartados em vez de exibidos como "fonte citada".
MIN_RELEVANCE_DISTANCE=1.5

# =============================================================================
# Servidor FastAPI
# =============================================================================
API_TITLE="Assistente IA com RAG"
API_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000
