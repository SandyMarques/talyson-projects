# Provedor Principal de LLM (deepseek ou openai)
LLM_PROVIDER=deepseek

# Configurações do DeepSeek
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Provedor de Embeddings ('huggingface' local/gratuito ou 'openai')
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Configurações da OpenAI (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Configurações do ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=rag_documents

# Configurações do RAG e Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4

# Configurações do Servidor FastAPI
API_TITLE="Assistente IA com RAG"
API_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000
