# Cadastre estas variáveis no painel da Vercel (Settings > Environment Variables).
# NUNCA commite o valor real.
DEEPSEEK_API_KEY=sua-chave-aqui
# Opcional: origens liberadas no CORS, separadas por vírgula (padrão: https://sandymarques.github.io)
ALLOWED_ORIGINS=https://sandymarques.github.io
# Opcional: modelo do DeepSeek (padrão: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat
